[Unit]
Description=TabUp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tabup
Group=tabup
WorkingDirectory=/opt/tabup
EnvironmentFile=/etc/tabup.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3457
Environment=TABUP_DB=/var/lib/tabup/tabup.db
Environment=TABUP_DATA_DIR=/var/lib/tabup
ExecStart=/usr/bin/node /opt/tabup/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tabup
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
MemoryMax=1G
TasksMax=256
CPUQuota=150%
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
