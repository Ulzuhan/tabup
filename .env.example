# ── Datos ───────────────────────────────────────────────────────────
# Rutas ABSOLUTAS en producción: el artefacto standalone arranca desde su propio
# directorio, así que una ruta relativa apuntaría dentro del build.
#TABUP_DB=/var/lib/tabup/tabup.db
#TABUP_DATA_DIR=/var/lib/tabup

# ── Cuentas propias (el modo por defecto) ───────────────────────────
# closed (por defecto) | approval | open. La PRIMERA cuenta entra siempre y es
# el admin: créala antes de exponer la instancia a internet.
#TABUP_REGISTRATION=closed

# ── O un proveedor OIDC (Authentik, Keycloak, Zitadel, Auth0…) ──────
# Con estas cuatro fijadas, el formulario local desaparece y entrar es cosa del
# proveedor. No hay proveedor por defecto: cada URL se exige y se valida.
#TABUP_OIDC_CLIENT_ID=
#TABUP_OIDC_CLIENT_SECRET=
#TABUP_OIDC_REDIRECT_URI=https://tabup.example.com/api/auth/callback
#TABUP_OIDC_PUBLIC_BASE=https://auth.example.com
# INTERNAL cae a PUBLIC si no se fija; loopback HTTP se admite para un proveedor
# en la misma máquina.
#TABUP_OIDC_INTERNAL_BASE=http://127.0.0.1:9100
#TABUP_OIDC_APP_SLUG=tabup
#TABUP_OIDC_TIMEOUT=10000

# Dónde pide cuenta quien no tiene: el flujo de alta de TU proveedor. Sale en la
# portada y en la página de invitación. Sin fijar no hay botón — que es lo correcto
# si tu proveedor no tiene alta autoservicio.
#TABUP_ENROLL_URL=https://auth.example.com/if/flow/enroll-tabup/

# La página de la cuenta en el proveedor: correo, contraseña, segundo factor, sesiones.
# Nada de eso es de TabUp, y sin esta variable la aplicación simplemente no enlaza a
# ningún sitio. La ruta es cosa de cada proveedor; Authentik la sirve en /if/user/.
#TABUP_ACCOUNT_URL=https://auth.example.com/if/user/

# ── Despliegue ──────────────────────────────────────────────────────
# Host público contra el que compara el guardián de origen. Sin fijar usa el
# `Host` que llega, que es lo correcto detrás de un túnel que lo conserva. Sólo
# hace falta si el proxy lo reescribe con un nombre interno.
#TABUP_PUBLIC_HOST=tabup.example.com
#PORT=3457

# ── OCR de recibos (opcional; sin ello la app funciona igual) ───────
#TABUP_OLLAMA_URL=http://127.0.0.1:11434
#TABUP_OCR_MODEL=qwen3.5:397b-cloud
#TABUP_OCR_TIMEOUT=60000

# ── Cambio de divisa ────────────────────────────────────────────────
#TABUP_RATE_TIMEOUT=5000

# ── Notificaciones push (VAPID) ─────────────────────────────────────
#TABUP_PUSH_SUBJECT=mailto:you@example.com

# ── Copias ──────────────────────────────────────────────────────────
#TABUP_BACKUP_DIR=~/backups/tabup
#TABUP_BACKUP_KEEP=14
#TABUP_BACKUP_REMOTE=
